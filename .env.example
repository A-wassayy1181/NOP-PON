# LLM Provider Configuration
# Choose one: openai or anthropic
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (alternative to OpenAI)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Email Configuration for Human Escalation (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Party contact email for escalations
ESCALATION_EMAIL=Northernontarioparty@hotmail.com

# Data path (default: ./clean_data)
DATA_PATH=./clean_data

# Stripe Configuration (Sandbox)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Payment Guardrails
PAYMENT_SPENDING_CAP=100.00
PAYMENT_REQUIRE_CONFIRMATION_ABOVE=50.00
